{
  "name": "9router-app",
  "version": "0.5.4",
  "description": "9Router web dashboard",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "next dev --port 20127",
    "dev:webpack": "next dev --webpack --port 20127",
    "build": "next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "node scripts/copy-standalone-assets.mjs",
    "start": "node custom-server.js --port 20127",
    "dev:env": "dotenvx run -f .env.encrypted -- next dev --port 20127",
    "start:env": "dotenvx run -f .env.encrypted -- node custom-server.js --port 20127",
    "dev:bun": "bun --bun next dev --webpack --port 20127",
    "build:bun": "bun --bun next build --webpack",
    "start:bun": "bun ./.next/standalone/custom-server.js",
    "dev:docker": "docker compose -f compose.dev.yml up",
    "dev:docker:down": "docker compose -f compose.dev.yml down",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli",
    "test": "cd tests && rm -f results.json && npx vitest run --update=new --reporter=json --outputFile=results.json; node __baseline__/verify-no-regression.mjs results.json",
    "lint": "./scripts/style.sh lint",
    "lint:modified": "./scripts/style.sh lint --modified",
    "lint:staged": "./scripts/style.sh lint --staged",
    "lint:unstaged": "./scripts/style.sh lint --unstaged",
    "lint:fix": "./scripts/style.sh lint --fix",
    "lint:fix:modified": "./scripts/style.sh lint --fix --modified",
    "format": "./scripts/style.sh format",
    "format:modified": "./scripts/style.sh format --modified",
    "format:staged": "./scripts/style.sh format --staged",
    "format:unstaged": "./scripts/style.sh format --unstaged"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@node-saml/node-saml": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^6.0.0",
    "confbox": "^0.3.1",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "jose": "^6.1.3",
    "marked": "^18.0.1",
    "material-symbols": "^0.47.5",
    "monaco-editor": "^0.57.0",
    "next": "^16.1.6",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "prop-types": "^15.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.7.0",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^10.1.0",
    "sql.js": "^1.14.1",
    "undici": "^7.30.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@dotenvx/dotenvx": "2.30.0",
    "@tailwindcss/postcss": "^4.1.18",
    "lefthook": "2.1.14",
    "markdownlint-cli": "0.49.1",
    "postcss": "^8.5.6",
    "prettier": "3.9.9",
    "tailwindcss": "^4"
  }
}
