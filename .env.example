# tokenhop environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/tokenhop

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Optional: pin request logging from the environment. Leave unset to control it
# from Settings → Observability. When set (true or false), it overrides both the
# "Record request details" and "Log every request to console" toggles.
# ENABLE_REQUEST_LOGS=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
# Optional: a cloud endpoint you run yourself. Leave unset and nothing is sent
# anywhere; tokenhop has no default cloud service.
# CLOUD_URL=
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
# NEXT_PUBLIC_CLOUD_URL=

# Optional: a stable-URL relay for the Cloudflare quick tunnel that you run
# yourself (https origin). Unset = no relay; the tunnel's own
# *.trycloudflare.com URL is used and nothing is registered with a third party.
# TUNNEL_WORKER_URL=

# Model capability catalog: a daily anonymous GET of https://models.dev/api.json
# (no identifiers sent). Set to "off" to disable the background sync.
# MODEL_CATALOG_SYNC=off

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Google OAuth "installed app" clients, for the gemini / gemini-cli (GEMINI_*) and
# antigravity (ANTIGRAVITY_*) providers. Built into the official Docker image and npm
# package already, so these are only needed to override the built-in pair or when
# running from source. Not committed: use the public client values shipped by Gemini
# CLI / Antigravity IDE.
# GEMINI_OAUTH_CLIENT_ID=
# GEMINI_OAUTH_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Meta Code (Muse Spark) device-code OAuth client, for the meta-code provider.
# Public client id of the muse CLI launcher (~/.local/bin/muse client_id); no secret.
# Built into the official Docker image and npm package; set only to override or when
# running from source.
# META_CODE_OAUTH_CLIENT_ID=

# Optional Claude Code client fingerprint for the `claude` (OAuth) provider.
# Defaults match Claude Code 2.1.280. These move together per Claude Code
# release — bump them as a set; a malformed value fails startup.
# CLAUDE_CLI_VERSION=2.1.280
# CLAUDE_CLI_SDK_VERSION=0.112.1
# CLAUDE_CLI_RUNTIME_VERSION=v26.3.0
# Comma-separated Anthropic-Beta base list. Opus/sonnet heavy-agent flags are added
# on top; fast-mode-2026-02-01 is added per request only for `speed: "fast"`
# (listing it here has no effect otherwise).
# CLAUDE_CLI_BETA_FLAGS=claude-code-20250219,oauth-2025-04-20,...

# Optional Zed client version for the `zed` provider, sent as
# `User-Agent: Zed/<v> (<os>; <arch>)` and `x-zed-version`. Zed Cloud gates
# clients by version; bump it if Zed reports a minimum required version.
# Must be X.Y.Z; a malformed value fails startup.
# ZED_CLIENT_VERSION=1.20.2

# Optional Codex CLI version for the `codex` provider, sent as
# `User-Agent: codex_cli_rs/<v>` and as `client_version` on the live model
# catalog. OpenAI hides models newer than the client, so bump it with your
# Codex CLI (`codex --version`). Must be X.Y.Z; a malformed value fails startup.
# CODEX_CLI_VERSION=0.155.1

# Optional Grok CLI version for the `grok-cli` provider (Grok Build), sent as
# `x-grok-client-version` and in `User-Agent: grok-shell/<v>`. xAI rejects clients
# older than its minimum with HTTP 426, so bump it with your Grok CLI
# (`grok --version`). Must be X.Y.Z; a malformed value fails startup.
# GROK_CLI_VERSION=1.0.44

# Dev/CI only; users never set this. Selects the product brand for the tokenhop
# rebrand: "9router" (the default) or "tokenhop". Next.js inlines it into the
# bundles at build time, so it must be set for `npm run build`, not just at
# start. Empty counts as unset; any other value throws when the brand module
# (src/shared/brand) loads.
# NEXT_PUBLIC_BRAND=tokenhop

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=tokenhop
